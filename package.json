{
  "name": "cc-mods-tts",
  "version": "0.6.0",
  "private": true,
  "description": "Claude Code TTS mod",
  "license": "MIT",
  "engines": {
    "node": "^22.11.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/sync-plugin-version.mjs && npm install --package-lock-only --ignore-scripts",
    "check:version": "node scripts/sync-plugin-version.mjs --check",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc -p .",
    "validate": "claude plugin validate --strict .",
    "test": "claude plugin test .",
    "check": "npm run lint && npm run validate && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "typescript": "5.8.3"
  }
}
